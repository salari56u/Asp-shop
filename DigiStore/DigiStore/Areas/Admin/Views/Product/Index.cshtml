@model ShopViewModel

@{
    ViewBag.Title = "مدیریت محصولات";
    string imagePath = "/wp-content/uploads/2025/01/";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; 
}

<style>
    .portfolio-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        border-radius: 0.75rem;
        overflow: hidden;
    }

        .portfolio-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.1) !important;
        }

    .portfolio-card-img {
        height: 220px;
        width: 100%; 
        object-fit: contain; 
        background-color: #f8f9fa;
        padding: 10px; 
    }

    .action-buttons a {
        transition: color 0.2s ease;
    }
</style>

<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="bx bxs-paint-roll"></i></div>
                        مدیریت نمونه کارها
                    </h1>
                    <div class="page-header-subtitle">نمایش، ویرایش و مدیریت محصولات وب‌سایت</div>
                </div>
                <div class="col-auto mt-4">
                    <a href="@Url.Action("Create")" class="btn btn-teal shadow-sm">
                        <i class="bx bx-plus me-1"></i> افزودن محصول جدید
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-n10">
    <div class="card shadow-lg border-0 rounded-lg">

        <div class="card-header bg-transparent border-bottom-0 p-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0">لیست محصولات</h5>
            <form method="get" action="@Url.Action("Index")" class="d-flex">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="جستجو..." />
                <button type="submit" class="btn btn-sm btn-primary">بگرد</button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary ms-1">حذف فیلتر</a>
                }
            </form>
        </div>

        <div class="card-body p-4">
            @if (!Model.Products.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bx bx-info-circle bx-lg d-block mb-2"></i>
                    محصولی یافت نشد.
                </div>
            }
            else
            {
                <div class="row gx-4 gy-4">
                    @foreach (var item in Model.Products)
                    {
                        <div class="col-xl-4 col-md-6">
                            <div class="card portfolio-card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(item.MainImageName))
                                {
                                    <img class="card-img-top portfolio-card-img" src="@imagePath@item.MainImageName" alt="@item.Title">
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/400x250.png?text=No+Image" class="card-img-top portfolio-card-img" alt="No Image" />
                                }

                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@item.Title</h5>
                                    <p class="card-text text-muted small">
                                        @(item.Description != null && item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                    </p>
                                </div>

                                <div class="card-footer bg-transparent border-0 pt-0 pb-3 d-flex justify-content-end action-buttons">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="text-primary me-3" title="ویرایش">
                                        <i class="bx bx-pencil bx-sm"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="text-danger" title="حذف">
                                        <i class="bx bx-trash bx-sm"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage - 1, search = Model.Search })" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.Search })">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.CurrentPage + 1, search = Model.Search })" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>