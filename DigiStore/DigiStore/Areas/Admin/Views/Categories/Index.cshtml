@model List<Category>

@{
    ViewBag.Title = "مدیریت کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml"; // نیازی نیست اگر در _ViewStart تنظیم شده باشد
}

@* Page Header *@
<header class="page-header page-header-dark bg-gradient-primary-to-secondary pb-10">
    <div class="container-xl px-4">
        <div class="page-header-content pt-4">
            <div class="row align-items-center justify-content-between">
                <div class="col-auto mt-4">
                    <h1 class="page-header-title">
                        <div class="page-header-icon"><i class="bx bxs-user-account"></i></div>
                        مدیریت دسته بندی ها
                    </h1>
                    <div class="page-header-subtitle">لیست دسته بندی های ثبت شده در وب‌سایت</div>
                </div>
                <div class="col-auto mt-4">
                    <a href="@Url.Action("Create")" class="btn btn-teal shadow-sm">
                        <i class="bx bx-user-plus me-1"></i> افزودن دسته بندی جدید
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<div class="container-xl px-4 mt-n10">

    @* Display Success/Error Messages from TempData *@
    @if (ViewBag.Message != null)
    {
        <div class="alert @(ViewBag.IsSuccess == true ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-lg border-0 rounded-lg mb-4">
        <div class="card-header bg-transparent border-bottom-0 p-4">
            <h5 class="mb-0">لیست  دسته بندی ها</h5>
        </div>
        <div class="card-body p-4">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bx bx-info-circle bx-lg d-block mb-2"></i>
                    هنوز هیچ کاربری ثبت نشده است.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th style=" width: 80px;" class="text-center">آواتار</th>
                                <th>@Html.DisplayNameFor(model => model.First().Title)</th>
                                <th style="width: 150px;" class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle">
                                        @if (!string.IsNullOrEmpty(item.ImageName))
                                        {
                                            <img src="@Url.Content("/wp-content/uploads/Categories/" + item.ImageName)" class="img-fluid rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            @* Default avatar icon *@
                                            <div class="avatar avatar-placeholder" style="width: 40px; height: 40px;">
                                                <div class="avatar-initials rounded-circle bg-gray-300 text-dark">
                                                    <i class="bx bx-user"></i>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                    <td class=" align-middle fw-500">@Html.DisplayFor(modelItem => item.Title)</td> @* ضخیم کردن نام *@
                                    <td class="text-center align-middle text-center">
                                        @* وسط‌چین کردن دکمه‌ها *@
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-datatable btn-icon btn-transparent-dark me-2" title="ویرایش">
                                            <i class="bx bx-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-datatable btn-icon btn-transparent-dark" title="حذف">
                                            <i class="bx bx-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div> @* end card-body *@
    </div> @* end card *@
</div> @* end container *@

