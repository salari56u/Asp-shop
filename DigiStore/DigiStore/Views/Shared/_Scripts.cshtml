                            // مثلا: url: '/Product/SearchJson',

                            /* $.ajax({
                                url: '/Home/Search', // آدرس اکشن شما در کنترلر
                                type: 'GET', // معمولا جستجو GET است
                                data: { keyword: query },
                                success: function (data) {
                                    $('#datafetch').html(data);
                                }
                            });
                            */

                           // فعلا برای اینکه ارور ندهد فقط لودر را نشان می‌دهد
                           console.log("Searching for: " + query + " (Need to implement API)");

                        }, doneTypingInterval);
                    } else {
                        $('#datafetch').empty().removeClass('show');
                        $('.loader-ajax-search').removeClass('show');
                    }
                });
            });
        });
    })(jQuery);
</script>

