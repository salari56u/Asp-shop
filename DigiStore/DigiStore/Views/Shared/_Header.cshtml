@inject ISiteSettingService SettingService
@{
	var settings = await SettingService.GetAllSettings();
	string GetSetting(string key, string defaultValue = "")
		=> settings.ContainsKey(key) ? settings[key] : defaultValue;
	var menuCategories = await SettingService.GetCategoriesForMenu();
}

<header class="header desktop ">

	<section class="main-header">
		<div class="container">
			<div class="top-header">
				<div class="top-header-right">
					<span>@GetSetting("Header_AlertText", "گوشی آیفون 16 رونمایی شد")</span>
				</div>
				<div class="top-header-left">
					<span class="contact-header">
						@GetSetting("Site_Phone", "09331234567") <i class="fas fa-headset"></i>
					</span>
				</div>
			</div>	
		</div>
	</section>

	<section class="mid-header">
		<div class="container">
			<div class="ch-mid-header">
				<div class="mid-header-right">
					<div class="logo">
						<a href="/">
							<img src="@GetSetting("Site_Logo", "/default-logo.png")" alt="لوگوی اصلی وب سایت" style="height:100px">
						</a>
					</div>
					<div class="search-main">
						<form action="#">
							<input type="search" class="ajax-search" name="s" placeholder="جستجو در محصولات" value="">
							<button type="submit">
								<i class="fa-solid fa-magnifying-glass"></i>
							</button>
						</form>
						<div class="loader-ajax-search">
							<span class="loader"></span>
						</div>
						<div id="datafetch" class="content-ajax-search"></div>
					</div>
				</div>
				<div class="mid-header-left">
					<div class="fav-btn">
						<a href="/Profile/List" target="_blank">
							<i class="fa-regular fa-heart"></i>
							<span class="text-fav-btn">
								علاقمندی ها
							</span>
						</a>
					</div>

					<div class="cart-btn">
						<a href="/Cart">
							<span class="text-cart-btn">
								<i class="fa-solid fa-cart-shopping"></i>
								<span>سبد خرید</span>
							</span>
							<span class="cart-btn-num" id="header-cart-count">
								0
							</span>
						</a>
						<div class="cart-content" id="mini-cart-container">
							<p class="woocommerce-mini-cart__empty-message">
								<img src="/wp-content/themes/moboland/img/shop-icon-mini.png" alt="">
								<span class="text-empty-cart-mini">سبد خرید شما خالی است.</span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="down-header">
		<div class="container">
			<div class="ch-down-header">
				<nav class="main-menu-header">
					<div class="megamenu-box">
						<div class="t-m">
							<i class="fa-solid fa-bars"></i>
							<span>دسته بندی محصولات</span>
						</div>
						<div class="moboland-megamenu">
							<ul id="menu-megamenu" class="menu">
								@foreach (var parent in menuCategories)
								{
									<li class="menu-item menu-item-has-children">
										<a href="@Url.Action("Index", "Product", new { categoryId = parent.Id })">@parent.Title</a>

										@if (parent.Children != null && parent.Children.Any())
										{
											<ul class="sub-menu">
												@foreach (var child in parent.Children)
												{
													<li class="menu-item">
														<a href="/Category/@child.Id">@child.Title</a>
													</li>
												}
											</ul>
										}
									</li>
								}
							</ul>
						</div>
					</div>
					<div class="menu-header">
						<ul id="menu-%d9%85%d9%86%d9%88%db%8c-%d8%a7%d8%b5%d9%84%db%8c-%d9%88%d8%a8-%d8%b3%d8%a7%db%8c%d8%aa" class="menu">
							<li id="menu-item-55" class="menu-item menu-item-type-custom menu-item-object-custom current-menu-item current_page_item menu-item-home menu-item-55"><a href="@Url.Action("Index" , "Home")" aria-current="page">صفحه اصلی</a></li>
							<li id="menu-item-231" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-231"><a href="/Product/Index">فروشگاه</a></li>
							<li id="menu-item-562" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-562"><a href="@Url.Action("Index", "Home")">تماس با ما</a></li>
							<li id="menu-item-1020" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-1020"><a href="@Url.Action("Index", "Home")">درباره ما</a></li>
						</ul>
					</div>
				</nav>


				@if (User.Identity.IsAuthenticated)
				{
					<div class="register-btn" style="border: 1px solid #2ecc71; color: #2ecc71;">
						<i class="far fa-user"></i>
						<a href="/Profile/Index"><span>@User.Identity.Name</span> </a>
						<a href="/Account/Logout" style="margin-right: 10px; font-size: 12px; color: red;">(خروج)</a>
					</div>
				}
				else
				{
					<div class="register-btn" id="btn_modal_login">
						<i class="far fa-circle-user"></i>
						<span>ورود/ثبت نام</span>
					</div>
				}
			</div>
		</div>
	</section>
</header>


