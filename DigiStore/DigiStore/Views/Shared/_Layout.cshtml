        var wc_add_to_cart_params = { "ajax_url": "/Home/Ajax", "wc_ajax_url": "/?wc-ajax=%%endpoint%%", "i18n_view_cart": "مشاهده سبد خرید", "cart_url": "/Cart", "is_cart": "", "cart_redirect_after_add": "no" };
        var woocommerce_params = { "ajax_url": "/Home/Ajax", "wc_ajax_url": "/?wc-ajax=%%endpoint%%" };
    </script>

    <script src="/wp-content/plugins/woocommerce/assets/js/frontend/add-to-cart.mind3a6.js"></script>
    <script src="/wp-content/plugins/woocommerce/assets/js/frontend/woocommerce.mind3a6.js"></script>

