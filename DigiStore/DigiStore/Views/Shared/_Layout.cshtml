<body class="rtl home wp-singular page-template page-template-elementor_header_footer page page-id-247 wp-theme-moboland theme-moboland woocommerce-no-js woo-variation-swatches wvs-behavior-blur wvs-theme-moboland wvs-show-label wvs-tooltip elementor-default elementor-template-full-width elementor-kit-244 elementor-page elementor-page-247">

    <partial name="_Modals" />

    <partial name="_Header" />

    <div class="main-container">
        @RenderBody()
    </div>

    <partial name="_Footer" />

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        jQuery(document).ready(function($) {

            function updateMiniCart() {
                $.ajax({
                    url: '/Cart/GetMiniCart', 
                    type: 'GET',
                    success: function(html) {
                        $('#mini-cart-container').html(html);
                        var count = $('#cart-total-count-value').val();
                        if(!count) count = 0;
                        $('#header-cart-count').text(count);
                    }
                });
            }
            updateMiniCart();
            function updateBtnLiking()
            {
                 var productId = $('.single_add_to_list_button').data('product-id');
                $.ajax({
                    url: '/Profile/checkLikingUser', 
                    type: 'GET',
                    data:{productid : productId},
                    success: function(response) {
                        if(response.success)
                        {
                            $('[data-product-id="' + productId + '"]').filter('.single_add_to_list_button').hide();
                            $('[data-product-id="' + productId + '"]').filter('.single_remove_to_list_button').show();
                        }
                        else{
                             $('[data-product-id="' + productId + '"]').filter('.single_add_to_list_button').show();
                            $('[data-product-id="' + productId + '"]').filter('.single_remove_to_list_button').hide();
                        }
                    }
                });
            }

            updateBtnLiking();

            var btnSelector = '.add_to_cart_button, .single_add_to_cart_button, .ajax_add_to_cart';
            var btnSelector1 = '.single_add_to_list_button, .ajax_add_to_list ';

            $('body').on('click' , btnSelector1,function(e)
            {
                 var productId = $(this).data('product-id');
                $.ajax({
                    url: "/Profile/addToLiking", 
                    type: "POST",
                   data: { productid: productId},
                    success: function (response) {
                        console.log("Success:", response);
                        updateBtnLiking();   
                    },
                    error: function (error) {
                         console.error("Error removing from favorites:", error);
                    }
                });
            });


            var btnSelector2 = '.single_remove_to_list_button, .ajax_remove_to_list ';

             $('body').on('click' , btnSelector2,function(e)
            {
               var productId = $(this).data('product-id');
                $.ajax({
                    url: "/Profile/RemoveFromList",
                    type: "POST",
                   data: { productid: productId},
                    success: function (response) {
                        console.log("Success:", response);
                          updateBtnLiking();
                    },
                    error: function (error) {
                        console.error("Error:", error);
                    }
                });
            });


            $('body').on('click', btnSelector, function(e) {
                e.preventDefault();
                var $btn = $(this);
                var productId = null;
                var quantity = 1;
                if ($btn.data('product_id')) {
                    productId = $btn.data('product_id');
                } else {
                    var $form = $btn.closest('form');
                    productId = $form.find('input[name="product_id"]').val() || $form.find('input[name="add-to-cart"]').val();
                    var qtyInput = $form.find('input[name="quantity"]').val();
                    if(qtyInput) quantity = qtyInput;
                }

                if (!productId) return;
                var originalText = $btn.html();
                $btn.html('<i class="fa fa-spinner fa-spin"></i>');
                $btn.css('pointer-events', 'none'); 

                $.ajax({
                    url: '/Cart/AddToCart',
                    type: 'POST',
                    data: { productId: productId, quantity: quantity },
                    success: function(response) {
                        if(response.success) {
                            updateMiniCart();
                            alert("✅ محصول به سبد اضافه شد");
                        } else {
                            alert("❌ " + response.message);
                        }
                    },
                    complete: function() {
                        $btn.html(originalText);
                        $btn.css('pointer-events', 'auto');
                    }
                });
            });
        });
    </script>
</body>
</html>