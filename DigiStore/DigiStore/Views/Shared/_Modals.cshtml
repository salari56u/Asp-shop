<div id="compare-popup" style="display: none;">
    <button onclick="document.getElementById('compare-popup').style.display='none'" class="close-compare-popup">×</button>
    <div id="compare-popup-content"></div>
</div>

<div id="compare-toast" class="compare-toast" style="display: none;">
    محصول به لیست مقایسه اضافه شد.
</div>

<div id="compare-loader" class="compare-loader" style="display: none;">
    <div class="compare-spinner"></div>
</div>

<div id="compare-toast-remove" class="compare-toast compare-toast-remove"></div>

<div id="modal_add_to_cart" class="modal">
    <div class="modal-content modal-add-to-cart">
        <i class="fa-solid fa-check"></i>
        محصول به سبد خرید اضافه شد
    </div>
</div>

<div id="modal_login" class="modal">
    <div class="modal-content">
        <div class="form-login-moboland">
            <span class="close_login"><i class="fa-solid fa-xmark"></i></span>

            <div class="logo">
                <a href="/">
                    <img src="/wp-content/uploads/2024/11/logo-web.webp" alt="لوگوی اصلی وب سایت">
                </a>
            </div>

            <div id="step-1-mobile">
                <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
                    <label>شماره موبایل خود را وارد کنید:</label>
                    <input type="tel" class="woocommerce-Input woocommerce-Input--text input-text"
                           id="login_mobile" placeholder="09xxxxxxxxx" style="text-align:center; letter-spacing: 2px;" />
                </p>
                <p class="woocommerce-form-row form-row">
                    <button type="button" onclick="sendOtp()" class="woocommerce-Button button" id="btn-send-otp">
                        دریافت کد تایید
                    </button>
                </p>
            </div>

            <div id="step-2-code" style="display:none;">
                <p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
                    <label>کد ارسال شده به <span id="mobile-display" style="font-weight:bold"></span> را وارد کنید:</label>
                    <input type="text" class="woocommerce-Input input-text"
                           id="login_code" placeholder="----" maxlength="4" style="text-align:center; letter-spacing: 5px; font-size: 20px;" />
                </p>
                <p class="woocommerce-form-row form-row">
                    <button type="button" onclick="verifyOtp()" class="woocommerce-Button button" id="btn-verify-otp">
                        ورود به حساب
                    </button>
                </p>
                <p class="message" style="margin-top:10px;">
                    <a href="#" onclick="resetLogin()">تغییر شماره موبایل</a>
                </p>
            </div>

            <div id="login-message" style="margin-top: 15px; text-align: center; color: red;"></div>

        </div>
    </div>
</div>

<div class="overlay"></div>

<script>
    function sendOtp() {
        var mobile = $('#login_mobile').val();

        // اعتبار سنجی ساده
        if (mobile.length !== 11 || !mobile.startsWith("09")) {
            $('#login-message').text("شماره موبایل معتبر نیست.");
            return;
        }

        $('#btn-send-otp').text('در حال ارسال...').prop('disabled', true);

        $.ajax({
            url: '/Account/SendOtp',
            type: 'POST',
            data: { phoneNumber: mobile },
            success: function (response) {
                if (response.success) {
                    // تغییر به مرحله دوم
                    $('#step-1-mobile').slideUp();
                    $('#step-2-code').slideDown();
                    $('#mobile-display').text(mobile);
                    $('#login-message').text("").css('color', 'green');
                } else {
                    $('#login-message').text(response.message).css('color', 'red');
                    $('#btn-send-otp').text('دریافت کد تایید').prop('disabled', false);
                }
            },
            error: function () {
                $('#login-message').text("خطا در ارتباط با سرور").css('color', 'red');
                $('#btn-send-otp').text('دریافت کد تایید').prop('disabled', false);
            }
        });
    }

    function verifyOtp() {
        var mobile = $('#login_mobile').val();
        var code = $('#login_code').val();

        if (code.length < 4) {
            $('#login-message').text("کد تایید کامل نیست").css('color', 'red');
            return;
        }

        $('#btn-verify-otp').text('در حال بررسی...').prop('disabled', true);

        $.ajax({
            url: '/Account/VerifyOtp',
            type: 'POST',
            data: { phoneNumber: mobile, code: code },
            success: function (response) {
                if (response.success) {
                    $('#login-message').text("ورود موفقیت آمیز!").css('color', 'green');
                    // رفرش صفحه برای اعمال لاگین
                    location.reload();
                } else {
                    $('#login-message').text(response.message).css('color', 'red');
                    $('#btn-verify-otp').text('ورود به حساب').prop('disabled', false);
                }
            }
        });
    }

    function resetLogin() {
        $('#step-2-code').slideUp();
        $('#step-1-mobile').slideDown();
        $('#btn-send-otp').text('دریافت کد تایید').prop('disabled', false);
        $('#login_code').val('');
        $('#login-message').text('');
    }
</script>

<div class="overlay"></div>