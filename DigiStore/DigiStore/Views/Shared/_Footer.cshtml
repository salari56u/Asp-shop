@using System.Text.Json
@inject ISiteSettingService SettingService
@{
    var settings = await SettingService.GetAllSettings();
    string GetSetting(string key, string defaultValue = "")
        => settings.ContainsKey(key) ? settings[key] : defaultValue;
}

<footer class="footer">
    <div class="container">
        <div class="footer-box">
            <aside class="footer-widget first-ch">
                <div class="f-w-content">
                    <h3>@GetSetting("Footer_AboutTitle", "فروشگاه موبولند")</h3>
                    <div class="textwidget">
                        <p>@GetSetting("Footer_AboutText", "لورم ایپسوم متن ساختگی...")</p>
                    </div>
                </div>
            </aside>
            <aside class="footer-widget">
                <div class="f-w-content">
                    <h3>خدمات مشتریان</h3>
                    <div class="textwidget">
                        <ul>
                            @{
                                var servicesJson = GetSetting("Footer_CustomerServices", "[]");
                                var services = JsonSerializer.Deserialize<List<FooterLink>>(servicesJson);
                            }
                            @if (services != null)
                            {
                                foreach (var link in services)
                                {
                                    <li><a href="@link.Url">@link.Title</a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </aside>
            @functions {
                public class FooterLink
                {
                    public string Title { get; set; }
                    public string Url { get; set; }
                }
            }
        </div>


        <div class="footer-line">
            <div class="footer-line-right">
                @GetSetting("Footer_WorkingHours", "پاسخگویی همه روزه از ساعت 9:00 الی 21:00") |
                شماره تماس: @GetSetting("Site_Phone")
            </div>
            <div class="footer-line-left">
                <span id="go-up">
                    <div class="text-go-up"> برو به بالا</div>
                    <i class="fas fa-chevron-up"></i>
                </span>
            </div>
        </div>
        <div class="footer-down">
            <div class="copyright">
                <p>@GetSetting("Footer_Copyright", "کلیه حقوق این وب سایت متعلق به فروشگاه موبولند است.")</p>
            </div>
            <div class="social-media">
                <a href="@GetSetting("Social_Instagram", "#")" target="_blank"><i class="fab fa-instagram-square"></i></a>
                <a href="@GetSetting("Social_Telegram", "#")" target="_blank"><i class="fab fa-telegram"></i></a>
                @* بقیه موارد هم به همین صورت *@
            </div>
        </div>
    </div>
    <div class="floating-contact">
        <div class="contact-list">
            <a href="tel:@GetSetting("Site_Phone")">
                <span>ارتباط از طریق تماس</span>
                <img src="/wp-content/themes/moboland/img/contact/contact.svg" alt="">
            </a>
            <a href="@GetSetting("Social_Telegram")">
                <span>ارتباط از طریق تلگرام</span>
                <img src="/wp-content/themes/moboland/img/contact/telegram.svg" alt="">
            </a>
            <a href="@GetSetting("Social_Instagram")">
                <span>ارتباط از طریق اینستاگرام</span>
                <img src="/wp-content/themes/moboland/img/contact/instagram.svg" alt="">
            </a>
            <a href="@GetSetting("Social_Bale")">
                <span>ارتباط از طریق بله</span>
                <img src="/wp-content/themes/moboland/img/contact/bale.svg" alt="">
            </a>
            <a href="mailto:@GetSetting("Site_Email")">
                <span>ارتباط از طریق ایمیل</span>
                <img src="/wp-content/themes/moboland/img/contact/email.svg" alt="">
            </a>
            <a href="@GetSetting("Social_WhatsApp")">
                <span>ارتباط از طریق واتس اپ</span>
                <img src="/wp-content/themes/moboland/img/contact/whatsup.svg" alt="">
            </a>
        </div>
        <div class="floating-button">
            <i class="fas fa-comment-dots"></i>
        </div>
    </div>



</footer>