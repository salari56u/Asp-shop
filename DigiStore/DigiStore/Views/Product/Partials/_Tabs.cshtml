@model Product
<div class="tabs-container">
    <ul class="custom-tabs">
        <li class="active" onclick="openTab(event, 'desc')">نقد و بررسی</li>
        <li onclick="openTab(event, 'specs')">مشخصات فنی</li>
        <li onclick="openTab(event, 'comments')">
            نظرات
            @if (ViewData["ReviewCount"] != null && (int)ViewData["ReviewCount"] > 0)
            {
                <span class="badge bg-primary ms-1">@ViewData["ReviewCount"]</span>
            }
        </li>
    </ul>

    <div id="desc" class="tab-content active">
        @Html.Raw(Model.Description)
    </div>

    <div id="specs" class="tab-content">
        <table class="table table-striped">
            <tbody>
                @if (Model.Specifications != null)
                {
                    foreach (var spec in Model.Specifications)
                    {
                        <tr>
                            <th style="width:200px; color:#666;">@spec.Key</th>
                            <td>@spec.Value</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="comments" class="tab-content">
        @await Html.PartialAsync("Partials/_ProductReviews",
        new ProductReviewsViewModel
        {
            ProductId = Model.Id,
            ProductTitle = Model.Title,
            AverageRating = (double)ViewData["AverageRating"],
            ReviewCount = (int)ViewData["ReviewCount"],
            Reviews = (List<ReviewViewModel>)ViewData["Reviews"],
            HasUserReviewed = (bool)ViewData["HasUserReviewed"],
            IsLoggedIn = (bool)ViewData["IsLoggedIn"]
        })
    </div>
</div>