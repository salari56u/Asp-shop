@model Product
<!-- تب‌های توضیحات -->
<div class="tabs-container">
    <ul class="custom-tabs">
        <li class="active" onclick="openTab(event, 'desc')">نقد و بررسی</li>
        <li onclick="openTab(event, 'specs')">مشخصات فنی</li>
        <li onclick="openTab(event, 'comments')">نظرات</li>
    </ul>

    <div id="desc" class="tab-content active">
        @Html.Raw(Model.Description)
    </div>

    <div id="specs" class="tab-content">
        <table class="table table-striped">
            <tbody>
                @if (Model.Specifications != null)
                {
                    foreach (var spec in Model.Specifications)
                    {
                        <tr>
                            <th style="width:200px; color:#666;">@spec.Key</th>
                            <td>@spec.Value</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="comments" class="tab-content">
        <p>فعلا نظری ثبت نشده است.</p>
    </div>
</div>