@model Product
@{
    string imagePath = "/wp-content/uploads/2025/01/";
}


<!-- بخش گالری حرفه‌ای (سمت راست) -->
<div class="gallery-section">
    <div class="main-image-box" id="zoom-container">
        <img id="main-image" src="@imagePath@Model.MainImageName" alt="@Model.Title" />
    </div>

    <div class="thumbs-list">
        <!-- عکس اصلی به عنوان اولین تامبنیل -->
        <div class="thumb-item active" onclick="changeImage('@imagePath@Model.MainImageName', this)">
            <img src="@imagePath@Model.MainImageName" alt="main" />
        </div>

        @if (Model.Images != null)
        {
            foreach (var img in Model.Images)
            {
                <div class="thumb-item" onclick="changeImage('@imagePath@img.Url', this)">
                    <img src="@imagePath@img.Url" alt="gallery" />
                </div>
            }
        }
    </div>
</div>
