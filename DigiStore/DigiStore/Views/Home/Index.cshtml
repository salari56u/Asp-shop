@using DigiStore.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "صفحه اصلی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div data-elementor-type="wp-page" data-elementor-id="247" class="elementor elementor-247">

    <div class="elementor-element elementor-element-55ecf92 e-con-full elementor-hidden-tablet elementor-hidden-mobile e-flex e-con e-parent" data-id="55ecf92" data-element_type="container">
        <div class="elementor-element elementor-element-aa2d1e5 elementor-widget elementor-widget-main_slider_widget" data-id="aa2d1e5" data-element_type="widget" data-widget_type="main_slider_widget.default">
            <div class="elementor-widget-container">
                <section class="main-slider">
                    <div class="owl-carousel owl-theme mm-slider">
                        @if(Model.Sliders !=null )
                        {
                            foreach(var item in Model.Sliders)
                            {
                                <div class="item">
                                    <a href="@item.Link"><img decoding="async" src="/wp-content/uploads/2024/11/@item.ImageName" alt="@item.Title"></a>
                                </div>
                            }
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>

    <partial name="Components/_HomeCategories" model="Model.Categories" />

    <partial name="Components/_HomeMobileSection" model="Model.MobileProducts"/>

    <partial name="Components/_HomeLatestProducts" model="Model.LatestProducts"/>

    <partial name="Components/_HomeLaptopSection" model="Model.LaptopProducts"/>

    @if(Model.WideBanner !=null)
    {
        <div class="elementor-element elementor-element-011b169 e-flex e-con-boxed e-con e-parent" data-id="011b169" data-element_type="container">
            <div class="e-con-inner">
                <div class="elementor-element elementor-element-49b6521 elementor-widget elementor-widget-image" data-id="49b6521" data-element_type="widget" data-widget_type="image.default">
                    <div class="elementor-widget-container">
                        <a href="@Model.WideBanner.Link">
                            <img loading="lazy" decoding="async" width="1611" height="240" src="/wp-content/uploads/2025/01/@Model.WideBanner.ImageName" class="attachment-full size-full wp-image-927" alt="" />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }


    <partial name="Components/_HomeMobileAccessories"  model="Model.AccessoryProducts"/>


    <partial name="Components/_HomeBestSellingProducts" model="Model.BestSellingProducts"/>


    <partial name="Components/_HomeFeatures" />

</div>

@section Scripts {
    <script>
        var $ = jQuery;
        $(document).ready(function () {

            // تنظیمات اسلایدر اصلی (Main Slider)
            $('.mm-slider').owlCarousel({
                loop: true,
                autoplay: true,
                margin: 0,
                nav: true,
                dots: true,
                rtl: true,
                navText: "",
                responsive: {
                    0: { items: 1 },
                    600: { items: 1 },
                    1000: { items: 1 }
                }
            });

            // تنظیمات اسلایدر دسته‌بندی (اگر فایل JS آن را از پارشیال حذف کردی، اینجا بگذار)
            $('.product-cat-slider').owlCarousel({
                loop: true,
                stagePadding: 20,
                autoplay: false,
                margin: 10,
                nav: true,
                rtl: true,
                navText: "",
                dots: false,
                responsive: {
                    0: { items: 2 },
                    500: { items: 2 },
                    576: { items: 2 },
                    768: { items: 4 },
                    992: { items: 5 },
                    1000: { items: 7 },
                    1400: { items: 9 }
                }
            });

            // تنظیمات اسلایدر محصولات (برای همه اسلایدرهای محصول کار می‌کند)
            $('.slider-product').owlCarousel({
                loop: false,
                margin: 10,
                nav: true,
                rtl: true,
                navText: "",
                dots: false,
                responsive: {
                    0: { items: 1 },
                    576: { items: 2 },
                    768: { items: 3 },
                    992: { items: 4 },
                    1200: { items: 5 }
                }
            });

        });
    </script>
}