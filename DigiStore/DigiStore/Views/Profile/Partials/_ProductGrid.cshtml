@model ShopLikingViewModel

<div id="product-grid-container">
    <div class="main-product" style="position: relative; min-height: 200px;">
        <div id="grid-loader" style="display:none; position:absolute; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.8); z-index:10; text-align:center; padding-top:50px;">
            <i class="fa-solid fa-spinner fa-spin fa-3x" style="color:#ef394e;"></i>
        </div>

        @if (Model.Products.Any())
        {
            foreach (var product in Model.Products)
            {
                <partial name="Partials/_ProductItem" model="product" />
            }
        }
        else
        {
            <div class="alert alert-warning w-100 text-center p-5">
                <i class="fa-solid fa-face-frown fa-2x mb-3"></i><br />
                محصولی یافت نشد.
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="woocommerce-pagination">
            <ul class='page-numbers'>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li>
                        <a class="page-numbers ajax-page-link @(i == Model.CurrentPage ? "current" : "")"
                           href="javascript:void(0)"
                           data-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>