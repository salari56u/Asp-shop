@using DigiStore.Data
@model ProfileViewModel
@{
    ViewData["Title"] = "پروفایل کاربری";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="bg-gradient bg-primary text-white text-center py-4">
                    <i class="bi bi-person-circle fs-1"></i>
                    <h5 class="mt-2 mb-0">@Model.UserName</h5>
                    <small>@Model.Mobile</small>
                </div>
                <div class="card-body text-center">
                    <span class="text-muted">حساب کاربری فعال</span>
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 mt-4">
                <div class="card-body text-center">
                    <div class="mb-2 text-success">
                        <i class="bi bi-wallet2 fs-3"></i>
                    </div>
                    <small class="text-muted">موجودی کیف پول</small>
                    <h3 class="mt-2 fw-bold text-success">
                        @Model.WalletBalance.ToString("N0") تومان
                    </h3>
                    <a class="nav-link" asp-controller="Profile" asp-action="Wallet">
                        <i class="bi bi-wallet me-1"></i>
                        افزایش موجودی
                    </a>
                </div>
            </div>

        </div>
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-bag-check me-2 text-primary"></i>سفارش‌های من
                    </h5>
                </div>

                <div class="card-body px-4 pb-4">

                    <div class="table-responsive">
                        <table class="table table-hover align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>تاریخ</th>
                                    <th>مبلغ</th>
                                    <th>وضعیت سفارش</th>
                                    <th>پرداخت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Orders.Any())
                                {
                                    foreach (var o in Model.Orders)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@o.OrderId</td>
                                            <td>@o.CreatedAt.ToString("yyyy/MM/dd")</td>
                                            <td>@o.FinalAmount.ToString("N0") تومان</td>
                                            <td>
                                                <span class="badge rounded-pill bg-secondary px-3 py-2">
                                                    @o.OrderStatus
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill @(o.PaymentStatus == PaymentStatus.Paid ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                                                    @o.PaymentStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted py-5">
                                            <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                            هنوز سفارشی ثبت نشده است
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>
